# Local Android and Gradle state
.gradle/
.kotlin/
.idea/
**/build/
local.properties
signing.properties

# Release and debug packages stay out of source control
*.apk
*.aab

# Signing material and local secrets
*.jks
*.keystore
*.pem
*.p12
.env
.env.*
!*.env.example

# Node dependencies and logs
node_modules/
npm-debug.log*

# CI log mirrors live in the branch only for failed runs; never build from them
.ci-mirror/

# Python bytecode from repo tooling
__pycache__/
tools/__pycache__/
